# Tercihen ayarları config.py üstüne yaz. Bu dosya isteğe bağlıdır.
# Kullanırsan ".env" adıyla kopyala. GitHub'a yükleme.

# ─── ZORUNLU ───
# my.telegram.org -> API development tools
API_ID=
API_HASH=
# @BotFather'dan alınan bot token
BOT_TOKEN=
# MongoDB Atlas bağlantı adresi (mongodb+srv://...)
# Atlas → Network Access → Add IP → 0.0.0.0/0 (Railway için zorunlu)
MONGO_URL=
# Botun yönetici olduğu log grubunun ID'si (-100 ile başlar)
LOGGER_ID=
# Senin Telegram kullanıcı ID'n
OWNER_ID=
# Asistan hesabın Pyrogram session string'i
SESSION=

# ─── İSTEĞE BAĞLI ───
SESSION2=
SESSION3=
SUPPORT_CHANNEL=https://t.me/loncamusic
SUPPORT_CHAT=https://t.me/loncamusic
DURATION_LIMIT=180
QUEUE_LIMIT=50
PLAYLIST_LIMIT=20
AUTO_END=False
AUTO_LEAVE=False
VIDEO_PLAY=True

# ─── YOUTUBE (boş bırakın — token otomatik üretilir, cookie gerekmez) ───
PO_TOKEN=
VISITOR_DATA=
POT_PROVIDER_URL=
